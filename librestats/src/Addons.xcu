<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Addons" oor:package="org.openoffice.Office">
  <node oor:name="AddonUI">
    <!-- Top-level "LibreStats" menu, shown only in Calc.
         "service:" URLs create the named UNO service and call trigger("<command>"). -->
    <node oor:name="OfficeMenuBar">
      <node oor:name="org.librestats.menu" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">LibreStats</value></prop>
        <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
        <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
        <node oor:name="Submenu">
          <node oor:name="m01" oor:op="replace">
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Data Preparation</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
            <node oor:name="Submenu">
              <node oor:name="m01" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?outliers</value></prop>
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Outliers...</value></prop>
                <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
              </node>
              <node oor:name="m02" oor:op="replace">
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Missing Data</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
                <node oor:name="Submenu">
              <node oor:name="m01" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?missingDiagnose</value></prop>
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Diagnostics...</value></prop>
                <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
              </node>
              <node oor:name="m02" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?missingImpute</value></prop>
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Impute Missing Values...</value></prop>
                <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
              </node>
                </node>
              </node>
              <node oor:name="m03" oor:op="replace">
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Transform and Scale</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
                <node oor:name="Submenu">
              <node oor:name="m01" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?transform</value></prop>
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Transform...</value></prop>
                <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
              </node>
              <node oor:name="m02" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?scale</value></prop>
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Scale...</value></prop>
                <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
              </node>
              <node oor:name="m03" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?logratio</value></prop>
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Compositional Log-ratios...</value></prop>
                <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
              </node>
                </node>
              </node>
              <node oor:name="m04" oor:op="replace">
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Coding</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
                <node oor:name="Submenu">
              <node oor:name="m01" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?dummies</value></prop>
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Dummy Variables...</value></prop>
                <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
              </node>
              <node oor:name="m02" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?presence</value></prop>
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Presence/Absence...</value></prop>
                <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
              </node>
              <node oor:name="m03" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?bins</value></prop>
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Discretize into Bins...</value></prop>
                <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
              </node>
              <node oor:name="m04" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?recode</value></prop>
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Recode Categories...</value></prop>
                <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
              </node>
              <node oor:name="m05" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?ranks</value></prop>
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Ranks and Normal Scores...</value></prop>
                <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
              </node>
                </node>
              </node>
            </node>
          </node>
          <node oor:name="m02" oor:op="replace">
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Data Visualization</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
            <node oor:name="Submenu">
              <node oor:name="m01" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?histogram</value></prop>
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Histogram...</value></prop>
                <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
              </node>
              <node oor:name="m02" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?qq</value></prop>
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Normal Q-Q Plot...</value></prop>
                <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
              </node>
              <node oor:name="m03" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?surface</value></prop>
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">3D Surface Plot...</value></prop>
                <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
              </node>
            </node>
          </node>
          <node oor:name="m03" oor:op="replace">
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Assumption Checks</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
            <node oor:name="Submenu">
              <node oor:name="m01" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?normality</value></prop>
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Normality (Shapiro-Wilk)...</value></prop>
                <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
              </node>
              <node oor:name="m02" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?variances</value></prop>
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Equal Variances (Levene / Brown-Forsythe)...</value></prop>
                <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
              </node>
            </node>
          </node>
          <node oor:name="m04" oor:op="replace">
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Comparison Tests</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
            <node oor:name="Submenu">
              <node oor:name="m01" oor:op="replace">
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">t-Tests</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
                <node oor:name="Submenu">
              <node oor:name="m01" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?ttestOne</value></prop>
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">One-Sample t-Test...</value></prop>
                <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
              </node>
              <node oor:name="m02" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?ttestWelch</value></prop>
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Welch's t-Test (Two Samples)...</value></prop>
                <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
              </node>
              <node oor:name="m03" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?ttestPaired</value></prop>
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Paired t-Test...</value></prop>
                <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
              </node>
                </node>
              </node>
              <node oor:name="m02" oor:op="replace">
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">ANOVA</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
                <node oor:name="Submenu">
              <node oor:name="m01" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?anovaOneWay</value></prop>
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">One-Way ANOVA...</value></prop>
                <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
              </node>
              <node oor:name="m02" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?anovaWelch</value></prop>
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Welch's ANOVA...</value></prop>
                <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
              </node>
              <node oor:name="m03" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?anovaRM</value></prop>
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Repeated-Measures ANOVA...</value></prop>
                <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
              </node>
                </node>
              </node>
              <node oor:name="m03" oor:op="replace">
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Post Hoc Tests</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
                <node oor:name="Submenu">
              <node oor:name="m01" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?posthocTukey</value></prop>
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Tukey HSD...</value></prop>
                <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
              </node>
              <node oor:name="m02" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?posthocGamesHowell</value></prop>
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Games-Howell...</value></prop>
                <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
              </node>
              <node oor:name="m03" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?posthocDunnett</value></prop>
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Dunnett (Each Group vs Control)...</value></prop>
                <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
              </node>
              <node oor:name="m04" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?posthocDunn</value></prop>
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Dunn (after Kruskal-Wallis)...</value></prop>
                <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
              </node>
                </node>
              </node>
            </node>
          </node>
          <node oor:name="m05" oor:op="replace">
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">DOE / RSM</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
            <node oor:name="Submenu">
              <node oor:name="m01" oor:op="replace">
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">New Design</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
                <node oor:name="Submenu">
                  <node oor:name="m01" oor:op="replace">
                    <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Screening</value></prop>
                    <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
                    <node oor:name="Submenu">
                      <node oor:name="m01" oor:op="replace">
                        <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?doeFull</value></prop>
                        <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Full Factorial (2 Levels)...</value></prop>
                        <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                        <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
                      </node>
                      <node oor:name="m02" oor:op="replace">
                        <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?doeFractional</value></prop>
                        <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Fractional Factorial 2^(k-p)...</value></prop>
                        <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                        <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
                      </node>
                      <node oor:name="m03" oor:op="replace">
                        <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?doePlackettBurman</value></prop>
                        <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Plackett-Burman...</value></prop>
                        <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                        <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
                      </node>
                    </node>
                  </node>
                  <node oor:name="m02" oor:op="replace">
                    <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Response Surface</value></prop>
                    <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
                    <node oor:name="Submenu">
                      <node oor:name="m01" oor:op="replace">
                        <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?doeCCD</value></prop>
                        <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Central Composite (CCD)...</value></prop>
                        <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                        <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
                      </node>
                      <node oor:name="m02" oor:op="replace">
                        <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?doeBoxBehnken</value></prop>
                        <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Box-Behnken...</value></prop>
                        <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                        <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
                      </node>
                    </node>
                  </node>
                </node>
              </node>
              <node oor:name="m02" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?doeAnalyseScreening</value></prop>
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Analyse Screening Design...</value></prop>
                <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
              </node>
              <node oor:name="m03" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string"><value>service:org.librestats.Handler?doeAnalyseRSM</value></prop>
                <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Analyse Response Surface Design...</value></prop>
                <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
              </node>
            </node>
          </node>
        </node>
      </node>
    </node>
  </node>
</oor:component-data>
